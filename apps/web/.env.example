# Copy to .env.local (never commit it) to use a real Supabase project instead of the browser-only demo backend.
# 1. Create a free project at https://supabase.com
# 2. Run services/supabase/migrations/0001_init.sql in the SQL editor
# 3. Paste the project URL and the *anon public* key (Project Settings > API). Never use the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
